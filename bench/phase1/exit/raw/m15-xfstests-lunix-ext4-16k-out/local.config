# xfstests local.config for M15, generated by tests/exit/xfstests.sh (the @...@ words are replaced; nothing here is
# a path outside the scratch directory $LUNIX_SPIKE_DIR). TEST_DEV and SCRATCH_DEV are Lunix block devices (or, for
# the reference run, loop devices over files on the same disk). Mounts only under $LUNIX_SPIKE_DIR/mnt, nosuid,nodev.
export FSTYP=ext4
export TEST_DEV=/dev/ublkb0
export TEST_DIR=<scratch>/mnt/m15-xfstests-lunix-ext4-16k-test
export SCRATCH_DEV=/dev/ublkb1
export SCRATCH_MNT=<scratch>/mnt/m15-xfstests-lunix-ext4-16k-scratch
export MOUNT_OPTIONS="-o nosuid,nodev"
export TEST_FS_MOUNT_OPTS="-o nosuid,nodev"
export RESULT_BASE=<scratch>/m15-xfstests-lunix-ext4-16k-out/results
export TMPDIR=<scratch>/m15-xfstests-lunix-ext4-16k-out/tmp
# no udisks, no log-writes device, no scratch pool: tests that need them report "not run" on both targets alike
export DISABLE_UDISKS=1
