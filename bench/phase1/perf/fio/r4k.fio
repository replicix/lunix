; M16 Part A: 4K random read, cache hits (DESIGN §20: >= 500 K IOPS, p99 <= 150 us). Working set written first.
; Environment: DEV, WS (bytes), RUNTIME (30), RAMP (5), CPUS (fio CPU list), JOBS (8), QD (128), SEED.
[r4k]
filename=${DEV}
ioengine=io_uring
direct=1
rw=randread
bs=4k
iodepth=${QD}
numjobs=${JOBS}
size=${WS}
cpus_allowed=${CPUS}
time_based
runtime=${RUNTIME}
ramp_time=${RAMP}
randseed=${SEED}
group_reporting=1
; per-second maximum of the completion latency (ADR-33 T6 stall profile): lat_clat.N.log under ${LATLOG}
write_lat_log=${LATLOG}
log_avg_msec=1000
log_max_value=1
percentile_list=50:90:99:99.9:99.99
