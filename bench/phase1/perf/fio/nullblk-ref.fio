; M16 kernel reference in the same session (CONVENTIONS): the same cells on null_blk (memory backed, no completion
; delay). Environment: DEV (/dev/nullb0), RUNTIME, CPUS.
[global]
filename=${DEV}
ioengine=io_uring
direct=1
cpus_allowed=${CPUS}
time_based
runtime=${RUNTIME}
ramp_time=3
group_reporting=1
numjobs=8
percentile_list=50:99:99.9

[r4k]
rw=randread
bs=4k
iodepth=128

[w4k]
stonewall
rw=randwrite
bs=4k
iodepth=128

[seqw]
stonewall
rw=write
bs=1m
iodepth=32
offset_increment=512m
size=512m

[seqr]
stonewall
rw=read
bs=1m
iodepth=32
offset_increment=512m
size=512m
