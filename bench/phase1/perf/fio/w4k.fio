; M16 Part A: 4K random write, local (>= 300 K IOPS, journal-bound). 60 s. Each job writes its own slice of the working
; set (offset_increment) so the jobs do not share blocks. Environment as r4k.fio.
[w4k]
filename=${DEV}
ioengine=io_uring
direct=1
rw=randwrite
bs=4k
iodepth=${QD}
numjobs=${JOBS}
size=${SLICE}
offset_increment=${SLICE}
cpus_allowed=${CPUS}
time_based
runtime=${RUNTIME}
ramp_time=${RAMP}
randseed=${SEED}
refill_buffers=1
buffer_compress_percentage=50
group_reporting=1
; per-second maximum of the completion latency (ADR-33 T6 stall profile): lat_clat.N.log under ${LATLOG}
write_lat_log=${LATLOG}
log_avg_msec=1000
log_max_value=1
percentile_list=50:90:99:99.9:99.99
