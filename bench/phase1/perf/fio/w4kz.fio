; T6 fastrecheck: skewed 4K random write (zipf:1.2 over each job slice), otherwise as w4k.fio. 60 s.
[w4kz]
filename=${DEV}
ioengine=io_uring
direct=1
rw=randwrite
random_distribution=zipf:1.2
bs=4k
iodepth=${QD}
numjobs=${JOBS}
size=${SLICE}
offset_increment=${SLICE}
cpus_allowed=${CPUS}
time_based
runtime=${RUNTIME}
ramp_time=${RAMP}
randseed=${SEED}
refill_buffers=1
buffer_compress_percentage=50
group_reporting=1
; per-second maximum of the completion latency (ADR-33 T6 stall profile): lat_clat.N.log under ${LATLOG}
write_lat_log=${LATLOG}
log_avg_msec=1000
log_max_value=1
percentile_list=50:90:99:99.9:99.99
