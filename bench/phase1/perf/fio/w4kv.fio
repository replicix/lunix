; pgracemix: read-back verification while the collector works off the last repetition's backlog: 4K random write with crc32c verify of the
; most recent writes (verify_backlog), fatal on a mismatch. Same slices as the measured job. Environment as w4k.fio.
[w4kv]
filename=${DEV}
ioengine=io_uring
direct=1
rw=randwrite
bs=4k
iodepth=${QD}
numjobs=${JOBS}
size=${SLICE}
offset_increment=${SLICE}
cpus_allowed=${CPUS}
time_based
runtime=${RUNTIME}
randseed=${SEED}
refill_buffers=1
buffer_compress_percentage=50
verify=crc32c
verify_backlog=1024
verify_fatal=1
group_reporting=1
