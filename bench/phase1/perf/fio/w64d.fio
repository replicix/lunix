; refsoak cell 4 (dedup-heavy): 64K random write, aligned to the 64K chunk, half of the blocks duplicates of earlier blocks
; (fio dedupe_percentage, so a chunk-level hash matches). Environment as w4k.fio, plus BS (default 64k). Runs RUNTIME s.
[w64d]
filename=${DEV}
ioengine=io_uring
direct=1
rw=randwrite
bs=64k
iodepth=${QD}
numjobs=${JOBS}
size=${SLICE}
offset_increment=${SLICE}
cpus_allowed=${CPUS}
time_based
runtime=${RUNTIME}
ramp_time=${RAMP}
randseed=${SEED}
dedupe_percentage=50
buffer_compress_percentage=50
group_reporting=1
write_lat_log=${LATLOG}
log_avg_msec=1000
log_max_value=1
percentile_list=50:90:99:99.9:99.99
